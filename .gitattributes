# The checker lock and the hashes under certificates/ and commitment/
# cover raw file bytes. LF line endings on every checkout, Windows
# included, keep those bytes the same as the ones that were hashed.
* text=auto eol=lf

*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.txt text eol=lf
SHA256SUMS text eol=lf
ROOT text eol=lf
Makefile text eol=lf
NOTICE text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
